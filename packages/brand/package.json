{
  "name": "@prabhix/brand",
  "version": "0.2.0",
  "type": "module",
  "description": "Prabhix design tokens, Tailwind preset and SVG marks. Token source: tokens.json.",
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "check": "node scripts/build-tokens.mjs --check && node scripts/check-literals.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "check:literals": "node scripts/check-literals.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.json": "./tokens.json",
    "./prabhix-tokens.css": "./prabhix-tokens.css",
    "./tailwind-preset.css": "./tailwind-preset.css",
    "./marks/*": "./marks/*"
  },
  "files": [
    "tokens.json",
    "prabhix-tokens.css",
    "tailwind-preset.css",
    "TOKENS.md",
    "marks",
    "src",
    "scripts"
  ],
  "sideEffects": [
    "*.css"
  ]
}
