  "themes": {
    "$doc": "Each product picks two accent ramps, a surface temperature and a default density. Two accents is what lets a theme compose — gradients, charts, illustrations and section headers all come from the pair. That is the whole of what a product may vary. To audition a different identity, change 'accent' or 'accent2' here and rebuild.",
    "technologies": { "label": "Prabhix Technologies", "accent": "cyan",   "accent2": "indigo",  "neutral": "neutral", "density": "comfortable", "surfaces": "marketing site, Identity hosted login" },
    "oneops":       { "label": "OneOps",               "accent": "indigo", "accent2": "fuchsia", "neutral": "neutral", "density": "comfortable", "surfaces": "oneOps/web (APP=oneops), Flutter oneops" },
    "admin":        { "label": "Admin console",        "accent": "violet", "accent2": "cyan",    "neutral": "neutral", "density": "compact",     "surfaces": "oneOps/web (APP=admin), Flutter admin", "chrome": "near-black shell; violet accent so internal tooling is never mistaken for a customer product" },
    "mobistack":    { "label": "MobiStack",            "accent": "ochre",  "accent2": "teal",    "neutral": "sand",    "density": "compact",     "surfaces": "MobiStack/web, Flutter mobistack", "warningRole": "tint-only — never a solid fill, because ochre and yellow share an arc" },
    "mailroom":     { "label": "Mailroom",             "accent": "clay",   "accent2": "teal",    "neutral": "sand",    "density": "comfortable", "surfaces": "Mailroom/web, Flutter mailroom" }
  },

  "contrast": {
    "$doc": "Pairs the build asserts on every run. fg/bg are semantic role names; min is the WCAG ratio required for that role.",
    "require": [
      { "fg": "ink", "bg": "bg", "min": 4.5 },
      { "fg": "ink", "bg": "surface", "min": 4.5 },
      { "fg": "ink-muted", "bg": "bg", "min": 4.5 },
      { "fg": "ink-muted", "bg": "surface", "min": 4.5 },
      { "fg": "ink-faint", "bg": "surface", "min": 3.0 },
      { "fg": "accent", "bg": "surface", "min": 4.5 },
      { "fg": "accent-ink", "bg": "accent", "min": 4.5 },
      { "fg": "accent-subtle-ink", "bg": "accent-subtle", "min": 4.5 },
      { "fg": "accent-2", "bg": "surface", "min": 3.0 },
      { "fg": "accent-2-ink", "bg": "accent-2", "min": 4.5 },
      { "fg": "accent-2-subtle-ink", "bg": "accent-2-subtle", "min": 4.5 },
      { "fg": "success", "bg": "surface", "min": 4.5 },
      { "fg": "success-subtle-ink", "bg": "success-subtle", "min": 4.5 },
      { "fg": "warning-subtle-ink", "bg": "warning-subtle", "min": 4.5 },
      { "fg": "danger", "bg": "surface", "min": 4.5 },
      { "fg": "danger-ink", "bg": "danger", "min": 4.5 },
      { "fg": "danger-subtle-ink", "bg": "danger-subtle", "min": 4.5 },
      { "fg": "info", "bg": "surface", "min": 4.5 },
      { "fg": "info-subtle-ink", "bg": "info-subtle", "min": 4.5 },
      { "fg": "border-strong", "bg": "surface", "min": 3.0 },
      { "fg": "border-strong", "bg": "bg", "min": 3.0 },
      { "fg": "focus", "bg": "surface", "min": 3.0 },
      { "fg": "focus", "bg": "bg", "min": 3.0 }
    ],
    "note": "'border' is deliberately absent. It draws decorative dividers and is not required to clear 3:1. Every boundary that identifies a control uses 'border-strong', which is asserted above. That distinction is the fix for the single-border-token bug described in Infra/docs/UX-PLAN.md."
  }
}
