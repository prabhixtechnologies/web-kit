{
  "$meta": {
    "name": "Prabhix design tokens",
    "version": 2,
    "doc": "Infra/docs/UX-STANDARD.md",
    "rule": "This file is the only place a design literal exists. Everything else is generated by scripts/build-tokens.mjs. Do not hand-edit the generated files.",
    "outputs": [
      "prabhix-tokens.css",
      "tailwind-preset.css",
      "../../../Mobile/packages/prabhix_theme/lib/src/prabhix_tokens.dart",
      "TOKENS.md"
    ],
    "hueRule": "Hue carries identity, role carries meaning, and the two never overlap. Status hues (green, yellow, red, blue) are reserved and never serve as a product accent. Product accents take the remaining separated arcs. To audition a different identity for a product, change one 'accent' value under themes and rebuild."
  },

  "base": {
    "white": "#ffffff",
    "black": "#000000",
    "transparent": "transparent"
  },

  "primitive": {
    "neutral": {
      "$doc": "Cool slate. The structural neutral for Prabhix Technologies, OneOps and Admin. 950 is the house ink.",
      "50": "#f6f8fb", "100": "#eef2f7", "200": "#dfe6ef", "300": "#c8d4e1",
      "400": "#9aabc0", "500": "#71859d", "600": "#56687e", "700": "#435365",
      "800": "#2c3a49", "900": "#1a2532", "950": "#0c1524"
    },
    "sand": {
      "$doc": "Warm neutral. The surface temperature for the two physical-world products, MobiStack and Mailroom. Derived from Mailroom's existing paper and ink.",
      "50": "#faf8f4", "100": "#f4f1ea", "200": "#e9e3d7", "300": "#d8d0bf",
      "400": "#b3a993", "500": "#8d8273", "600": "#6a6358", "700": "#514b43",
      "800": "#35312c", "900": "#221f1a", "950": "#12100e"
    },
    "cyan": {
      "$doc": "House hue. Prabhix Technologies, the marketing site, Identity and the Admin console.",
      "50": "#ecfeff", "100": "#cffafe", "200": "#a5f3fc", "300": "#67e8f9",
      "400": "#22d3ee", "500": "#06b6d4", "600": "#0891b2", "700": "#0e7490",
      "800": "#155e75", "900": "#164e63", "950": "#083344"
    },
    "indigo": {
      "$doc": "OneOps. A broad business suite should read as a system of record.",
      "50": "#eef2ff", "100": "#e0e7ff", "200": "#c7d2fe", "300": "#a5b4fc",
      "400": "#818cf8", "500": "#6366f1", "600": "#4f46e5", "700": "#4338ca",
      "800": "#3730a3", "900": "#312e81", "950": "#1e1b4b"
    },
    "ochre": {
      "$doc": "MobiStack. Warm and high-contrast for a counter tool used standing up under shop lighting. Shares an arc with the yellow warning ramp, which is why warning is restricted to tinted roles inside the MobiStack theme.",
      "50": "#fffbeb", "100": "#fef3c7", "200": "#fde68a", "300": "#fcd34d",
      "400": "#fbbf24", "500": "#f59e0b", "600": "#d97706", "700": "#b45309",
      "800": "#92400e", "900": "#78350f", "950": "#451a03"
    },
    "clay": {
      "$doc": "Mailroom. Promoted from the one-off accent already in Mailroom/web/src/index.css to a full ramp; 400 is that file's existing dark-theme accent.",
      "50": "#fbf4f1", "100": "#f6e6df", "200": "#ecccbe", "300": "#dda894",
      "400": "#c17a62", "500": "#a85742", "600": "#9a4834", "700": "#8c3b2a",
      "800": "#713024", "900": "#5c2a20", "950": "#331512"
    },
    "green": {
      "$doc": "Reserved: success. 400 and 700 are the values already in prabhix-tokens.css.",
      "50": "#ecfdf3", "100": "#d1fadf", "200": "#a6f4c5", "300": "#6ce9a6",
      "400": "#32d583", "500": "#12b76a", "600": "#039855", "700": "#027a48",
      "800": "#05603a", "900": "#054f31", "950": "#053321"
    },
    "yellow": {
      "$doc": "Reserved: warning. Deliberately yellower than the ochre product ramp to open the gap.",
      "50": "#fefce8", "100": "#fef9c3", "200": "#fef08a", "300": "#fde047",
      "400": "#facc15", "500": "#eab308", "600": "#ca8a04", "700": "#a16207",
      "800": "#854d0e", "900": "#713f12", "950": "#422006"
    },
    "red": {
      "$doc": "Reserved: danger. 400 and 700 are the values already in prabhix-tokens.css.",
      "50": "#fef3f2", "100": "#fee4e2", "200": "#fecdca", "300": "#fda29b",
      "400": "#f97066", "500": "#f04438", "600": "#d92d20", "700": "#b42318",
      "800": "#912018", "900": "#7a271a", "950": "#55160c"
    },
    "blue": {
      "$doc": "Reserved: info. Previously absent from the token set entirely.",
      "50": "#eff6ff", "100": "#dbeafe", "200": "#bfdbfe", "300": "#93c5fd",
      "400": "#60a5fa", "500": "#3b82f6", "600": "#2563eb", "700": "#1d4ed8",
      "800": "#1e40af", "900": "#1e3a8a", "950": "#172554"
    },
    "violet": {
      "$doc": "Admin console. Internal tooling gets its own identity rather than borrowing the house hue.",
      "50": "#f5f3ff", "100": "#ede9fe", "200": "#ddd6fe", "300": "#c4b5fd",
      "400": "#a78bfa", "500": "#8b5cf6", "600": "#7c3aed", "700": "#6d28d9",
      "800": "#5b21b6", "900": "#4c1d95", "950": "#2e1065"
    },
    "teal": {
      "$doc": "Secondary accent for the two warm products. Complementary to ochre and clay, which is what makes those themes read as vivid rather than muddy.",
      "50": "#f0fdfa", "100": "#ccfbf1", "200": "#99f6e4", "300": "#5eead4",
      "400": "#2dd4bf", "500": "#14b8a6", "600": "#0d9488", "700": "#0f766e",
      "800": "#115e59", "900": "#134e4a", "950": "#042f2e"
    },
    "fuchsia": {
      "$doc": "Secondary accent for OneOps. Gives the densest product a second hue to compose with.",
      "50": "#fdf4ff", "100": "#fae8ff", "200": "#f5d0fe", "300": "#f0abfc",
      "400": "#e879f9", "500": "#d946ef", "600": "#c026d3", "700": "#a21caf",
      "800": "#86198f", "900": "#701a75", "950": "#4a044e"
    },
    "rose": {
      "$doc": "Categorical and tag use.",
      "50": "#fff1f2", "100": "#ffe4e6", "200": "#fecdd3", "300": "#fda4af",
      "400": "#fb7185", "500": "#f43f5e", "600": "#e11d48", "700": "#be123c",
      "800": "#9f1239", "900": "#881337", "950": "#4c0519"
    },
    "pink": {
      "$doc": "Categorical and tag use.",
      "50": "#fdf2f8", "100": "#fce7f3", "200": "#fbcfe8", "300": "#f9a8d4",
      "400": "#f472b6", "500": "#ec4899", "600": "#db2777", "700": "#be185d",
      "800": "#9d174d", "900": "#831843", "950": "#500724"
    },
    "lime": {
      "$doc": "Categorical and tag use. Kept away from the reserved success green by being distinctly yellower.",
      "50": "#f7fee7", "100": "#ecfccb", "200": "#d9f99d", "300": "#bef264",
      "400": "#a3e635", "500": "#84cc16", "600": "#65a30d", "700": "#4d7c0f",
      "800": "#3f6212", "900": "#365314", "950": "#1a2e05"
    }
  },

  "palette": {
    "categorical": {
      "$doc": "Charts, grouped series and generated avatars. Ordered so the first four stay distinguishable under deuteranopia and protanopia. Never pick a series colour by hand; never reuse a status hue for a series.",
      "light": ["#4338ca", "#0891b2", "#b45309", "#039855", "#9333ea", "#8c3b2a", "#0d9488", "#ca8a04", "#2563eb", "#db2777"],
      "dark":  ["#a5b4fc", "#22d3ee", "#fbbf24", "#32d583", "#c084fc", "#dda894", "#2dd4bf", "#facc15", "#60a5fa", "#f472b6"]
    },
    "tag": {
      "$doc": "The 14 user-assignable swatches for Mailroom tags and OneOps labels. Derived from the ramps by the rule below, so every swatch is guaranteed to clear AA in both themes without anyone hand-picking a pair. Replaces the hardcoded presets in oneOps/web/src/features/settings/mail/TagsPage.tsx and the free colour input.",
      "ramps": ["neutral", "red", "rose", "pink", "fuchsia", "violet", "indigo", "blue", "cyan", "teal", "green", "lime", "yellow", "ochre", "clay"],
      "derive": {
        "light": { "bg": "100", "ink": "800", "border": "200" },
        "dark": { "bg": "950", "ink": "300", "border": "900" }
      }
    },
    "gradient": {
      "$doc": "Composed from the two accents of the active theme, so every product gets its own gradient for free. Use for heroes, empty-state art, generated avatars, chart fills and section headers — the things that make a UI read as colourful rather than merely tinted. {role} substitutes a resolved semantic role.",
      "brand": "linear-gradient(135deg in oklab, {accent} 0%, 68%, {accent-2} 100%)",
      "brand-soft": "linear-gradient(135deg in oklab, {accent-subtle} 0%, 68%, {accent-2-subtle} 100%)",
      "brand-fade": "linear-gradient(180deg in oklab, {accent-subtle} 0%, {surface} 100%)",
      "mesh": "radial-gradient(60% 60% at 15% 15%, {accent-subtle} 0%, transparent 62%), radial-gradient(52% 52% at 85% 25%, {accent-2-subtle} 0%, transparent 60%), radial-gradient(60% 60% at 50% 100%, {bg-accent} 0%, transparent 65%)"
    }
  },

  "scale": {
    "space": {
      "$doc": "4px base. Harvested from MobiStack/web/src/styles.css, which already had the best structural scale in the portfolio.",
      "0": "0", "px": "1px", "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px",
      "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px",
      "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px"
    },
    "radius": {
      "$doc": "Five values, replacing the nine ad hoc radii in use across the Flutter apps.",
      "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "full": "9999px"
    },
    "borderWidth": { "hairline": "1px", "thick": "2px", "focus": "2px" },
    "opacity": { "disabled": "0.45", "muted": "0.7", "scrim": "0.6" },
    "elevation": {
      "$doc": "Composed shadows, cool-tinted in light and neutral-black in dark. Replaces the single --px-shadow.",
      "light": {
        "0": "none",
        "1": "0 1px 2px rgba(12, 21, 36, 0.06), 0 1px 1px rgba(12, 21, 36, 0.04)",
        "2": "0 2px 4px rgba(12, 21, 36, 0.06), 0 4px 8px rgba(12, 21, 36, 0.05)",
        "3": "0 4px 8px rgba(12, 21, 36, 0.06), 0 8px 16px rgba(12, 21, 36, 0.06)",
        "4": "0 8px 16px rgba(12, 21, 36, 0.07), 0 16px 32px rgba(12, 21, 36, 0.07)",
        "5": "0 16px 32px rgba(12, 21, 36, 0.08), 0 32px 64px rgba(12, 21, 36, 0.09)"
      },
      "dark": {
        "0": "none",
        "1": "0 1px 2px rgba(0, 0, 0, 0.4), 0 1px 1px rgba(0, 0, 0, 0.3)",
        "2": "0 2px 4px rgba(0, 0, 0, 0.4), 0 4px 8px rgba(0, 0, 0, 0.35)",
        "3": "0 4px 8px rgba(0, 0, 0, 0.45), 0 8px 16px rgba(0, 0, 0, 0.4)",
        "4": "0 8px 16px rgba(0, 0, 0, 0.5), 0 16px 32px rgba(0, 0, 0, 0.45)",
        "5": "0 16px 32px rgba(0, 0, 0, 0.55), 0 32px 64px rgba(0, 0, 0, 0.5)"
      }
    },
    "z": {
      "$doc": "Named layers, so nothing ever reaches for z-index: 9999 again.",
      "base": "0", "sticky": "100", "dropdown": "200", "overlay": "300",
      "modal": "400", "toast": "500", "tooltip": "600"
    },
    "duration": { "instant": "0ms", "fast": "120ms", "normal": "180ms", "slow": "280ms" },
    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "font": {
      "display": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", serif",
      "body": "\"Source Sans 3\", \"Source Sans Pro\", \"Segoe UI\", sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "type": {
      "$doc": "Roles, not sizes. Each role fixes size, line-height, weight, tracking and family together. A component never sets font-size alone.",
      "display":  { "size": "3rem",      "lineHeight": "1.05", "weight": "700", "tracking": "-0.02em",  "font": "display" },
      "title-lg": { "size": "1.75rem",   "lineHeight": "1.2",  "weight": "700", "tracking": "-0.01em",  "font": "display" },
      "title-md": { "size": "1.25rem",   "lineHeight": "1.3",  "weight": "600", "tracking": "-0.005em", "font": "body" },
      "title-sm": { "size": "1rem",      "lineHeight": "1.4",  "weight": "600", "tracking": "0",        "font": "body" },
      "body-lg":  { "size": "1.0625rem", "lineHeight": "1.6",  "weight": "400", "tracking": "0",        "font": "body" },
      "body-md":  { "size": "0.9375rem", "lineHeight": "1.55", "weight": "400", "tracking": "0",        "font": "body" },
      "body-sm":  { "size": "0.875rem",  "lineHeight": "1.5",  "weight": "400", "tracking": "0",        "font": "body" },
      "label":    { "size": "0.8125rem", "lineHeight": "1.4",  "weight": "600", "tracking": "0.01em",   "font": "body" },
      "caption":  { "size": "0.75rem",   "lineHeight": "1.4",  "weight": "400", "tracking": "0.01em",   "font": "body" },
      "overline": { "size": "0.6875rem", "lineHeight": "1.3",  "weight": "600", "tracking": "0.1em",    "font": "body" },
      "mono":     { "size": "0.875rem",  "lineHeight": "1.5",  "weight": "400", "tracking": "0",        "font": "mono" }
    },
    "layout": {
      "container-sm": "40rem", "container-md": "56rem", "container-lg": "72rem",
      "container-xl": "88rem", "prose": "72ch",
      "sidebar": "16rem", "sidebar-collapsed": "4rem", "header": "3.5rem"
    },
    "breakpoint": { "sm": "40rem", "md": "48rem", "lg": "64rem", "xl": "80rem", "2xl": "96rem" },
    "density": {
      "$doc": "Two modes, switching row height, control height, padding and body type role together. MobiStack's counter and the Admin console default to compact.",
      "comfortable": { "row": "44px", "control": "40px", "padX": "16px", "padY": "10px", "bodyRole": "body-md" },
      "compact":     { "row": "34px", "control": "32px", "padX": "10px", "padY": "6px",  "bodyRole": "body-sm" }
    }
  },

  "semantic": {
    "$doc": "One role map, resolved per theme. {accent} and {neutral} are substituted from the theme definition, which is how the same component is cyan in OneOps and ochre in MobiStack with no conditional anywhere in the code.",
    "light": {
      "bg": "{neutral}.100",
      "bg-accent": "{accent}.50",
      "surface": "{neutral}.50",
      "surface-raised": "base.white",
      "surface-sunken": "{neutral}.200",
      "surface-hover": "{neutral}.100",
      "surface-active": "{neutral}.200",
      "surface-selected": "{accent}.50",
      "surface-disabled": "{neutral}.200",
      "ink": "{neutral}.950",
      "ink-muted": "{neutral}.600",
      "ink-faint": "{neutral}.500",
      "ink-disabled": "{neutral}.400",
      "ink-inverse": "base.white",
      "border": "{neutral}.300",
      "border-strong": "{neutral}.500",
      "border-accent": "{accent}.600",
      "accent": "{accent}.700",
      "accent-hover": "{accent}.800",
      "accent-active": "{accent}.900",
      "accent-selected": "{accent}.100",
      "accent-disabled": "{neutral}.300",
      "accent-ink": "base.white",
      "accent-subtle": "{accent}.50",
      "accent-subtle-ink": "{accent}.800",
      "accent-subtle-border": "{accent}.200",
      "accent-2": "{accent2}.700",
      "accent-2-hover": "{accent2}.800",
      "accent-2-ink": "base.white",
      "accent-2-subtle": "{accent2}.50",
      "accent-2-subtle-ink": "{accent2}.800",
      "accent-2-subtle-border": "{accent2}.200",
      "success": "green.700",
      "success-ink": "base.white",
      "success-subtle": "green.50",
      "success-subtle-ink": "green.800",
      "success-subtle-border": "green.200",
      "warning": "yellow.700",
      "warning-ink": "base.white",
      "warning-subtle": "yellow.50",
      "warning-subtle-ink": "yellow.800",
      "warning-subtle-border": "yellow.200",
      "danger": "red.700",
      "danger-hover": "red.800",
      "danger-ink": "base.white",
      "danger-subtle": "red.50",
      "danger-subtle-ink": "red.800",
      "danger-subtle-border": "red.200",
      "info": "blue.700",
      "info-ink": "base.white",
      "info-subtle": "blue.50",
      "info-subtle-ink": "blue.800",
      "info-subtle-border": "blue.200",
      "focus": "{accent}.700",
      "scrim": "{neutral}.950"
    },
    "dark": {
      "bg": "{neutral}.950",
      "bg-accent": "{accent}.950",
      "surface": "{neutral}.900",
      "surface-raised": "{neutral}.800",
      "surface-sunken": "{neutral}.950",
      "surface-hover": "{neutral}.800",
      "surface-active": "{neutral}.700",
      "surface-selected": "{accent}.950",
      "surface-disabled": "{neutral}.800",
      "ink": "{neutral}.50",
      "ink-muted": "{neutral}.400",
      "ink-faint": "{neutral}.500",
      "ink-disabled": "{neutral}.600",
      "ink-inverse": "{neutral}.950",
      "border": "{neutral}.800",
      "border-strong": "{neutral}.500",
      "border-accent": "{accent}.400",
      "accent": "{accent}.400",
      "accent-hover": "{accent}.300",
      "accent-active": "{accent}.200",
      "accent-selected": "{accent}.900",
      "accent-disabled": "{neutral}.700",
      "accent-ink": "{accent}.950",
      "accent-subtle": "{accent}.950",
      "accent-subtle-ink": "{accent}.300",
      "accent-subtle-border": "{accent}.900",
      "accent-2": "{accent2}.400",
      "accent-2-hover": "{accent2}.300",
      "accent-2-ink": "{accent2}.950",
      "accent-2-subtle": "{accent2}.950",
      "accent-2-subtle-ink": "{accent2}.300",
      "accent-2-subtle-border": "{accent2}.900",
      "success": "green.400",
      "success-ink": "green.950",
      "success-subtle": "green.950",
      "success-subtle-ink": "green.300",
      "success-subtle-border": "green.900",
      "warning": "yellow.400",
      "warning-ink": "yellow.950",
      "warning-subtle": "yellow.950",
      "warning-subtle-ink": "yellow.300",
      "warning-subtle-border": "yellow.900",
      "danger": "red.400",
      "danger-hover": "red.300",
      "danger-ink": "red.950",
      "danger-subtle": "red.950",
      "danger-subtle-ink": "red.300",
      "danger-subtle-border": "red.900",
      "info": "blue.400",
      "info-ink": "blue.950",
      "info-subtle": "blue.950",
