{
  "name": "@prabhix/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared React UI primitives for Prabhix product webs.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./preset.css": "./src/preset.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "//": [
    "Everything this package imports is a peer, and every consuming app must declare all of them.",
    "",
    "That is not a style choice. Apps link this package with `file:`, and npm does not install a",
    "linked package's own dependencies into the consumer - it assumes the link target's tree will",
    "serve. Vite's build agrees, because it resolves through the symlink to the real path. Vitest",
    "does not: it inlines linked sources and resolves from the link path, inside the app's own",
    "node_modules. So a dependency declared only here resolves at build time and fails at test",
    "time, which is the worst way for it to fail.",
    "",
    "Peers are therefore the only declaration that actually reaches the apps. The cost is that",
    "adding a primitive means adding its package in every app too, and the cost of forgetting",
    "used to be a red test suite in an unrelated file. `check-peers.mjs` in @prabhix/brand runs in",
    "every repo's CI and fails with the exact npm command to run, so it is caught here instead.",
    "",
    "react and react-dom are peers for the ordinary reason as well: hooks read a dispatcher off a",
    "module-level singleton, and two copies fail as \"Cannot read properties of null\"."
  ],
  "peerDependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.0",
    "lucide-react": ">=0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "0.511.0",
    "sonner": "2.0.5",
    "tailwind-merge": "3.3.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.0"
  }
}
